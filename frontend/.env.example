# "mock" keeps all data in the browser (localStorage) so the UI works before the
# backend exists. Switch to "http" once the API is running.
VITE_API_MODE=mock

# Base path of the REST API when VITE_API_MODE=http. In dev, /api is proxied to
# VITE_API_PROXY (see vite.config.ts).
VITE_API_URL=/api
VITE_API_PROXY=http://localhost:8000
